VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# CARTO basemaps now require a free key (carto.com/basemaps/apikey) or tiles
# render with an "API KEY REQUIRED" watermark. This key is sent with every
# tile request the browser makes, so it is not a privileged secret — but it
# should still live here (not hardcoded) so it can be rotated or restricted
# by referrer/domain from the CARTO dashboard without a code change.
VITE_CARTO_API_KEY=
